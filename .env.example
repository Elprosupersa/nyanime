# Base URL of the app used for OAuth redirects
APP_URL=https://ais-dev-usvjjbywgs5hnzhdpdfuqw-282466238391.us-west2.run.app

# AniList OAuth2 App Credentials
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# MyAnimeList OAuth2 App Credentials
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# Primary Web Push VAPID Keys (auto-generated if omitted; recommended reliable channel)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@nyanime.app

# Optional Firebase Cloud Messaging Web Push key pair from Firebase Console
VITE_FIREBASE_VAPID_KEY=
# DEPRECATED: Legacy FCM API (fcm.googleapis.com/fcm/send) was shut down by Google.
# Do NOT rely on FIREBASE_FCM_SERVER_KEY. Native FCM dispatch requires FCM HTTP v1
# with a Google Service Account (OAuth2); standard Web Push VAPID above is used by default.
FIREBASE_FCM_SERVER_KEY=

