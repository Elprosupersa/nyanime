{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil privado de usuario autenticado con Firebase Auth en NyAnime.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "ID único de Firebase Auth del usuario.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Correo electrónico del usuario.",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "description": "Nombre público elegido por el usuario.",
          "minLength": 1,
          "maxLength": 80
        },
        "avatar": {
          "type": "string",
          "description": "URL o Data URL comprimida del avatar seleccionado.",
          "maxLength": 40000
        },
        "profileUpdatedAt": {
          "type": "integer",
          "description": "Marca de tiempo de la última edición manual de nombre o avatar."
        },
        "providerId": {
          "type": "string",
          "description": "Proveedor de autenticación (google.com o password).",
          "maxLength": 40
        },
        "episodesWatched": {
          "type": "integer",
          "description": "Contador de episodios vistos."
        },
        "totalMinutes": {
          "type": "integer",
          "description": "Minutos totales reales de anime reproducidos."
        },
        "totalSecondsWatched": {
          "type": "integer",
          "description": "Segundos reales acumulados de reproducción."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de creación del perfil en servidor."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Última actualización del perfil."
        }
      },
      "required": ["uid", "email", "displayName", "avatar", "providerId", "episodesWatched", "totalMinutes", "createdAt", "updatedAt"]
    },
    "FavoriteAnime": {
      "title": "FavoriteAnime",
      "description": "Anime guardado en favoritos por el usuario.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "animeId": {
          "type": "integer"
        },
        "title": {
          "type": "object",
          "description": "Títulos romaji y english del anime."
        },
        "coverImage": {
          "type": "object",
          "description": "URLs de portada del anime."
        },
        "format": {
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "maxLength": 40
        },
        "episodes": {
          "type": "integer"
        },
        "genres": {
          "type": "array",
          "description": "Lista acotada de géneros del anime."
        },
        "idMal": {
          "type": "integer",
          "description": "ID opcional en MyAnimeList para AniSkip y Scrobble."
        },
        "averageScore": {
          "type": "integer",
          "description": "Puntuación promedio global (0-100)."
        },
        "listStatus": {
          "type": "string",
          "enum": ["watching", "plan_to_watch", "completed", "on_hold", "dropped"],
          "description": "Categoría del anime en la biblioteca del usuario."
        },
        "listUpdatedAt": {
          "type": "integer",
          "description": "Marca de tiempo de última actualización de categoría."
        },
        "userScore": {
          "type": "integer",
          "description": "Calificación personal del usuario (1 a 10)."
        },
        "userReview": {
          "type": "string",
          "maxLength": 280,
          "description": "Reseña corta del usuario."
        },
        "userNotes": {
          "type": "string",
          "maxLength": 500,
          "description": "Notas privadas sobre el anime."
        },
        "scoreUpdatedAt": {
          "type": "integer"
        },
        "customListIds": {
          "type": "array",
          "description": "IDs de listas personalizadas a las que pertenece."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "animeId", "title", "coverImage", "createdAt", "updatedAt"]
    },
    "FavoriteManga": {
      "title": "FavoriteManga",
      "description": "Manga o Manhwa guardado en biblioteca por el usuario.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mangaId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 240
        },
        "cover": {
          "type": "string",
          "maxLength": 600
        },
        "flag": {
          "type": "string",
          "maxLength": 40
        },
        "origLang": {
          "type": "string",
          "maxLength": 16
        },
        "score": {
          "type": "string",
          "maxLength": 16
        },
        "status": {
          "type": "string",
          "maxLength": 40
        },
        "year": {
          "type": "string",
          "maxLength": 16
        },
        "userScore": {
          "type": "integer"
        },
        "userReview": {
          "type": "string",
          "maxLength": 280
        },
        "userNotes": {
          "type": "string",
          "maxLength": 500
        },
        "scoreUpdatedAt": {
          "type": "integer"
        },
        "customListIds": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "mangaId", "title", "cover", "createdAt", "updatedAt"]
    },
    "WatchHistoryEntry": {
      "title": "WatchHistoryEntry",
      "description": "Registro de último episodio reproducido de un anime.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "animeId": {
          "type": "integer"
        },
        "animeTitle": {
          "type": "string",
          "maxLength": 240
        },
        "coverImage": {
          "type": "string",
          "maxLength": 600
        },
        "seasonNum": {
          "type": "integer"
        },
        "episodeNum": {
          "type": "integer"
        },
        "currentTime": {
          "type": "number",
          "description": "Segundo exacto guardado para reanudación."
        },
        "duration": {
          "type": "number",
          "description": "Duración total conocida del episodio en segundos."
        },
        "completed": {
          "type": "boolean",
          "description": "True si el episodio superó el 90% de reproducción."
        },
        "timestamp": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "animeId", "animeTitle", "seasonNum", "episodeNum", "timestamp", "createdAt", "updatedAt"]
    },
    "MangaProgressEntry": {
      "title": "MangaProgressEntry",
      "description": "Progreso de lectura y capítulos leídos de un manga.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mangaId": {
          "type": "string",
          "maxLength": 128
        },
        "mangaTitle": {
          "type": "string",
          "maxLength": 240
        },
        "cover": {
          "type": "string",
          "maxLength": 600
        },
        "flag": {
          "type": "string",
          "maxLength": 40
        },
        "origLang": {
          "type": "string",
          "maxLength": 16
        },
        "lastChapterNum": {
          "type": "number"
        },
        "lastChapterLabel": {
          "type": "string",
          "maxLength": 32
        },
        "readChapters": {
          "type": "array"
        },
        "timestamp": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "mangaId", "mangaTitle", "readChapters", "timestamp", "createdAt", "updatedAt"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Preferencias del lector y recordatorios de emisión del usuario.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "scheduleReminders": {
          "type": "array"
        },
        "readerBg": {
          "type": "string",
          "maxLength": 32
        },
        "readerWidth": {
          "type": "string",
          "maxLength": 32
        },
        "readerMode": {
          "type": "string",
          "maxLength": 32
        },
        "readerBrightness": {
          "type": "integer"
        },
        "readerContrast": {
          "type": "integer"
        },
        "readerSepia": {
          "type": "integer"
        },
        "readerContinuous": {
          "type": "boolean"
        },
        "autoSkipIntro": {
          "type": "boolean"
        },
        "autoSkipOutro": {
          "type": "boolean"
        },
        "autoScrobble": {
          "type": "boolean"
        },
        "pushEnabled": {
          "type": "boolean"
        },
        "weeklySummaryPush": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "scheduleReminders", "createdAt", "updatedAt"]
    },
    "UserSuggestion": {
      "title": "UserSuggestion",
      "description": "Sugerencia o reporte enviado por un usuario autenticado.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tipo": {
          "type": "string",
          "maxLength": 64
        },
        "texto": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "tipo", "texto", "createdAt"]
    },
    "EpisodeComment": {
      "title": "EpisodeComment",
      "description": "Comentario comunitario real asociado a un episodio específico.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "episodeKey": {
          "type": "string",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "avatar": {
          "type": "string",
          "maxLength": 40000
        },
        "text": {
          "type": "string",
          "minLength": 2,
          "maxLength": 500
        },
        "isSpoiler": {
          "type": "boolean",
          "description": "Indica si el comentario contiene spoilers que deben difuminarse."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "episodeKey", "displayName", "avatar", "text", "createdAt"]
    },
    "AnimeWatchedEntry": {
      "title": "AnimeWatchedEntry",
      "description": "Episodios vistos deduplicados por temporada/anime.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "seasonId": {
          "type": "string",
          "maxLength": 128
        },
        "watchedEpisodes": {
          "type": "array",
          "description": "Lista ordenada de números de episodios vistos."
        },
        "updatedAtMs": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "seasonId", "watchedEpisodes", "updatedAtMs", "createdAt", "updatedAt"]
    },
    "CustomList": {
      "title": "CustomList",
      "description": "Lista o colección personalizada creada por el usuario.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "listId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "color": {
          "type": "string",
          "maxLength": 24
        },
        "icon": {
          "type": "string",
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "listId", "name", "color", "icon", "createdAt", "updatedAt"]
    },
    "PushSubscriptionEntry": {
      "title": "PushSubscriptionEntry",
      "description": "Registro de suscripción Web Push / FCM del navegador o dispositivo del usuario.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "subId": {
          "type": "string",
          "maxLength": 128
        },
        "endpoint": {
          "type": "string",
          "maxLength": 600
        },
        "fcmToken": {
          "type": "string",
          "maxLength": 512
        },
        "provider": {
          "type": "string",
          "enum": ["fcm", "webpush"]
        },
        "deviceLabel": {
          "type": "string",
          "maxLength": 80
        },
        "enabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "subId", "endpoint", "createdAt", "updatedAt"]
    },
    "WatchRoom": {
      "title": "WatchRoom",
      "description": "Sala compartida en tiempo real para ver episodios sincronizados con amigos.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "animeId": {
          "type": "integer"
        },
        "seasonId": {
          "type": "integer",
          "description": "ID opcional de la temporada activa en AniList."
        },
        "animeTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "seasonNum": {
          "type": "integer"
        },
        "episodeNum": {
          "type": "integer"
        },
        "playbackState": {
          "type": "string",
          "enum": ["playing", "paused"]
        },
        "playbackTime": {
          "type": "number"
        },
        "updatedAtMs": {
          "type": "integer"
        },
        "updatedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedByName": {
          "type": "string",
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["active", "closed"]
        },
        "hasPasscode": {
          "type": "boolean"
        },
        "passcodeHash": {
          "type": "string",
          "maxLength": 128
        },
        "inviteTokenHash": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["roomId", "hostUid", "hostName", "animeId", "animeTitle", "seasonNum", "episodeNum", "playbackState", "playbackTime", "updatedAtMs", "status", "createdAt", "updatedAt"]
    },
    "WatchRoomParticipant": {
      "title": "WatchRoomParticipant",
      "description": "Participante conectado en una sala compartida.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomId": {
          "type": "string",
          "maxLength": 32
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "avatar": {
          "type": "string",
          "maxLength": 40000
        },
        "lastSeenMs": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "roomId", "displayName", "avatar", "lastSeenMs", "createdAt", "updatedAt"]
    },
    "WatchRoomMessage": {
      "title": "WatchRoomMessage",
      "description": "Mensaje en vivo dentro del mini-chat de una sala compartida.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "roomId": {
          "type": "string",
          "maxLength": 32
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "avatar": {
          "type": "string",
          "maxLength": 40000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "roomId", "displayName", "avatar", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Documento raíz del perfil privado de usuario."
    },
    "/users/{userId}/favorites/{favoriteId}": {
      "schema": { "$ref": "#/entities/FavoriteAnime" },
      "description": "Colección privada de animes en biblioteca del usuario con categoría."
    },
    "/users/{userId}/anime_watched/{seasonId}": {
      "schema": { "$ref": "#/entities/AnimeWatchedEntry" },
      "description": "Episodios vistos deduplicados por temporada o serie."
    },
    "/users/{userId}/manga_favorites/{mangaId}": {
      "schema": { "$ref": "#/entities/FavoriteManga" },
      "description": "Colección privada de mangas favoritos del usuario."
    },
    "/users/{userId}/history/{historyId}": {
      "schema": { "$ref": "#/entities/WatchHistoryEntry" },
      "description": "Historial privado de reproducción de anime."
    },
    "/users/{userId}/manga_progress/{mangaId}": {
      "schema": { "$ref": "#/entities/MangaProgressEntry" },
      "description": "Progreso privado de lectura y capítulos leídos por manga."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "Preferencias del lector, reproducción y recordatorios de emisión."
    },
    "/users/{userId}/custom_lists/{listId}": {
      "schema": { "$ref": "#/entities/CustomList" },
      "description": "Listas o colecciones temáticas personalizadas del usuario."
    },
    "/users/{userId}/push_subscriptions/{subId}": {
      "schema": { "$ref": "#/entities/PushSubscriptionEntry" },
      "description": "Suscripciones Web Push registradas por el usuario."
    },
    "/users/{userId}/suggestions/{suggestionId}": {
      "schema": { "$ref": "#/entities/UserSuggestion" },
      "description": "Sugerencias enviadas por el usuario."
    },
    "/episodes/{episodeKey}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/EpisodeComment" },
      "description": "Comentarios reales en tiempo real por episodio."
    },
    "/watch_rooms/{roomId}": {
      "schema": { "$ref": "#/entities/WatchRoom" },
      "description": "Salas en tiempo real de Watch Together."
    },
    "/watch_rooms/{roomId}/participants/{participantId}": {
      "schema": { "$ref": "#/entities/WatchRoomParticipant" },
      "description": "Participantes activos en una sala Watch Together."
    },
    "/watch_rooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/WatchRoomMessage" },
      "description": "Mensajes en tiempo real de una sala Watch Together."
    }
  }
}
