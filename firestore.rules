rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default-deny all unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity validation helpers matching firebase-blueprint.json
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'avatar', 'providerId', 'episodesWatched', 'totalMinutes', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'avatar', 'profileUpdatedAt', 'providerId', 'episodesWatched', 'totalMinutes', 'totalSecondsWatched', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.avatar is string && data.avatar.size() <= 40000
        && (!('profileUpdatedAt' in data) || (data.profileUpdatedAt is int && data.profileUpdatedAt >= 0))
        && data.providerId is string && data.providerId.size() >= 1 && data.providerId.size() <= 40
        && data.episodesWatched is int && data.episodesWatched >= 0 && data.episodesWatched <= 1000000
        && data.totalMinutes is int && data.totalMinutes >= 0 && data.totalMinutes <= 100000000
        && (!('totalSecondsWatched' in data) || (data.totalSecondsWatched is int && data.totalSecondsWatched >= 0 && data.totalSecondsWatched <= 6000000000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFavoriteAnime(data) {
      return data.keys().hasAll(['uid', 'animeId', 'title', 'coverImage', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'animeId', 'title', 'coverImage', 'format', 'status', 'episodes', 'genres', 'idMal', 'averageScore', 'listStatus', 'listUpdatedAt', 'userScore', 'userReview', 'userNotes', 'scoreUpdatedAt', 'customListIds', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.animeId is int && data.animeId >= 0
        && data.title is map
        && data.coverImage is map
        && (!('format' in data) || (data.format is string && data.format.size() <= 40))
        && (!('status' in data) || (data.status is string && data.status.size() <= 40))
        && (!('episodes' in data) || (data.episodes is int && data.episodes >= 0 && data.episodes <= 100000))
        && (!('genres' in data) || (data.genres is list && data.genres.size() <= 20))
        && (!('idMal' in data) || (data.idMal is int && data.idMal >= 0 && data.idMal <= 10000000))
        && (!('averageScore' in data) || (data.averageScore is int && data.averageScore >= 0 && data.averageScore <= 100))
        && (!('listStatus' in data) || data.listStatus in ['watching', 'plan_to_watch', 'completed', 'on_hold', 'dropped'])
        && (!('listUpdatedAt' in data) || (data.listUpdatedAt is int && data.listUpdatedAt >= 0))
        && (!('userScore' in data) || (data.userScore is int && data.userScore >= 1 && data.userScore <= 10))
        && (!('userReview' in data) || (data.userReview is string && data.userReview.size() <= 280))
        && (!('userNotes' in data) || (data.userNotes is string && data.userNotes.size() <= 500))
        && (!('scoreUpdatedAt' in data) || (data.scoreUpdatedAt is int && data.scoreUpdatedAt >= 0))
        && (!('customListIds' in data) || (data.customListIds is list && data.customListIds.size() <= 25 && (data.customListIds.size() == 0 || data.customListIds[0] is string)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFavoriteManga(data) {
      return data.keys().hasAll(['uid', 'mangaId', 'title', 'cover', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'mangaId', 'title', 'cover', 'flag', 'origLang', 'score', 'status', 'year', 'userScore', 'userReview', 'userNotes', 'scoreUpdatedAt', 'customListIds', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.mangaId is string && data.mangaId.size() >= 1 && data.mangaId.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 240
        && data.cover is string && data.cover.size() <= 600
        && (!('flag' in data) || (data.flag is string && data.flag.size() <= 40))
        && (!('origLang' in data) || (data.origLang is string && data.origLang.size() <= 16))
        && (!('score' in data) || (data.score is string && data.score.size() <= 16))
        && (!('status' in data) || (data.status is string && data.status.size() <= 40))
        && (!('year' in data) || (data.year is string && data.year.size() <= 16))
        && (!('userScore' in data) || (data.userScore is int && data.userScore >= 1 && data.userScore <= 10))
        && (!('userReview' in data) || (data.userReview is string && data.userReview.size() <= 280))
        && (!('userNotes' in data) || (data.userNotes is string && data.userNotes.size() <= 500))
        && (!('scoreUpdatedAt' in data) || (data.scoreUpdatedAt is int && data.scoreUpdatedAt >= 0))
        && (!('customListIds' in data) || (data.customListIds is list && data.customListIds.size() <= 25 && (data.customListIds.size() == 0 || data.customListIds[0] is string)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWatchHistoryEntry(data) {
      return data.keys().hasAll(['uid', 'animeId', 'animeTitle', 'seasonNum', 'episodeNum', 'timestamp', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'animeId', 'animeTitle', 'coverImage', 'seasonNum', 'episodeNum', 'currentTime', 'duration', 'completed', 'timestamp', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.animeId is int && data.animeId >= 0
        && data.animeTitle is string && data.animeTitle.size() >= 1 && data.animeTitle.size() <= 240
        && (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 600))
        && data.seasonNum is int && data.seasonNum >= 1 && data.seasonNum <= 200
        && data.episodeNum is int && data.episodeNum >= 0 && data.episodeNum <= 10000
        && (!('currentTime' in data) || (data.currentTime is number && data.currentTime >= 0 && data.currentTime <= 86400))
        && (!('duration' in data) || (data.duration is number && data.duration >= 0 && data.duration <= 86400))
        && (!('completed' in data) || data.completed is bool)
        && data.timestamp is int && data.timestamp >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMangaProgressEntry(data) {
      return data.keys().hasAll(['uid', 'mangaId', 'mangaTitle', 'readChapters', 'timestamp', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'mangaId', 'mangaTitle', 'cover', 'flag', 'origLang', 'lastChapterNum', 'lastChapterLabel', 'readChapters', 'timestamp', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.mangaId is string && data.mangaId.size() >= 1 && data.mangaId.size() <= 128
        && data.mangaTitle is string && data.mangaTitle.size() >= 1 && data.mangaTitle.size() <= 240
        && (!('cover' in data) || (data.cover is string && data.cover.size() <= 600))
        && (!('flag' in data) || (data.flag is string && data.flag.size() <= 40))
        && (!('origLang' in data) || (data.origLang is string && data.origLang.size() <= 16))
        && (!('lastChapterNum' in data) || data.lastChapterNum is number)
        && (!('lastChapterLabel' in data) || (data.lastChapterLabel is string && data.lastChapterLabel.size() <= 32))
        && data.readChapters is list && data.readChapters.size() <= 3000
        && data.timestamp is int && data.timestamp >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserSettings(data) {
      return data.keys().hasAll(['uid', 'scheduleReminders', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'scheduleReminders', 'readerBg', 'readerWidth', 'readerMode', 'readerBrightness', 'readerContrast', 'readerSepia', 'readerContinuous', 'autoSkipIntro', 'autoSkipOutro', 'autoScrobble', 'pushEnabled', 'weeklySummaryPush', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.scheduleReminders is list && data.scheduleReminders.size() <= 500
        && (!('readerBg' in data) || (data.readerBg is string && data.readerBg.size() <= 32))
        && (!('readerWidth' in data) || (data.readerWidth is string && data.readerWidth.size() <= 32))
        && (!('readerMode' in data) || (data.readerMode is string && data.readerMode.size() <= 32))
        && (!('readerBrightness' in data) || (data.readerBrightness is int && data.readerBrightness >= 45 && data.readerBrightness <= 130))
        && (!('readerContrast' in data) || (data.readerContrast is int && data.readerContrast >= 60 && data.readerContrast <= 140))
        && (!('readerSepia' in data) || (data.readerSepia is int && data.readerSepia >= 0 && data.readerSepia <= 70))
        && (!('readerContinuous' in data) || data.readerContinuous is bool)
        && (!('autoSkipIntro' in data) || data.autoSkipIntro is bool)
        && (!('autoSkipOutro' in data) || data.autoSkipOutro is bool)
        && (!('autoScrobble' in data) || data.autoScrobble is bool)
        && (!('pushEnabled' in data) || data.pushEnabled is bool)
        && (!('weeklySummaryPush' in data) || data.weeklySummaryPush is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomList(data, listId) {
      return data.keys().hasAll(['uid', 'listId', 'name', 'color', 'icon', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'listId', 'name', 'color', 'icon', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.listId is string && data.listId.size() >= 1 && data.listId.size() <= 64 && data.listId == listId
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 48
        && data.color is string && data.color.size() >= 1 && data.color.size() <= 24
        && data.icon is string && data.icon.size() >= 1 && data.icon.size() <= 16
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPushSubscriptionEntry(data, subId) {
      return data.keys().hasAll(['uid', 'subId', 'endpoint', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'subId', 'endpoint', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.subId is string && data.subId.size() >= 1 && data.subId.size() <= 128 && data.subId == subId
        && data.endpoint is string && data.endpoint.size() >= 8 && data.endpoint.size() <= 600
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWatchActor(actorUid) {
      return actorUid is string
        && actorUid.size() >= 1
        && actorUid.size() <= 128
        && actorUid.matches('^[a-zA-Z0-9_\\-]+$')
        && (
          (request.auth != null && actorUid == request.auth.uid)
          || (request.auth == null && actorUid.matches('^guest_[a-zA-Z0-9_\\-]{6,64}$'))
        );
    }

    function isValidWatchRoom(data, roomId) {
      return data.keys().hasAll(['roomId', 'hostUid', 'hostName', 'animeId', 'animeTitle', 'seasonNum', 'episodeNum', 'playbackState', 'playbackTime', 'updatedAtMs', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['roomId', 'hostUid', 'hostName', 'animeId', 'seasonId', 'animeTitle', 'seasonNum', 'episodeNum', 'playbackState', 'playbackTime', 'updatedAtMs', 'updatedByUid', 'updatedByName', 'status', 'createdAt', 'updatedAt'])
        && data.roomId is string && data.roomId.size() >= 4 && data.roomId.size() <= 32 && data.roomId == roomId
        && data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128
        && data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 80
        && data.animeId is int && data.animeId >= 0
        && (!('seasonId' in data) || (data.seasonId is int && data.seasonId >= 0))
        && data.animeTitle is string && data.animeTitle.size() >= 1 && data.animeTitle.size() <= 240
        && data.seasonNum is int && data.seasonNum >= 1 && data.seasonNum <= 200
        && data.episodeNum is int && data.episodeNum >= 1 && data.episodeNum <= 10000
        && data.playbackState in ['playing', 'paused']
        && data.playbackTime is number && data.playbackTime >= 0 && data.playbackTime <= 86400
        && data.updatedAtMs is int && data.updatedAtMs >= 0
        && (!('updatedByUid' in data) || isValidWatchActor(data.updatedByUid))
        && (!('updatedByName' in data) || (data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 80))
        && data.status in ['active', 'closed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWatchRoomParticipant(data, roomId, participantId) {
      return data.keys().hasAll(['uid', 'roomId', 'displayName', 'avatar', 'lastSeenMs', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'roomId', 'displayName', 'avatar', 'lastSeenMs', 'createdAt', 'updatedAt'])
        && isValidWatchActor(data.uid) && participantId == data.uid
        && data.roomId is string && data.roomId == roomId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.avatar is string && data.avatar.size() <= 40000
        && data.lastSeenMs is int && data.lastSeenMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWatchRoomMessage(data, roomId) {
      return data.keys().hasAll(['uid', 'roomId', 'displayName', 'avatar', 'text', 'createdAt'])
        && data.keys().hasOnly(['uid', 'roomId', 'displayName', 'avatar', 'text', 'createdAt'])
        && isValidWatchActor(data.uid)
        && data.roomId is string && data.roomId == roomId
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.avatar is string && data.avatar.size() <= 40000
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 280
        && data.createdAt is timestamp;
    }

    function isValidUserSuggestion(data) {
      return data.keys().hasAll(['uid', 'tipo', 'texto', 'createdAt'])
        && data.keys().hasOnly(['uid', 'tipo', 'texto', 'createdAt'])
        && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.tipo is string && data.tipo.size() >= 1 && data.tipo.size() <= 64
        && data.texto is string && data.texto.size() >= 1 && data.texto.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidEpisodeComment(data, episodeKey) {
      return data.keys().hasAll(['uid', 'episodeKey', 'displayName', 'avatar', 'text', 'createdAt'])
        && data.keys().hasOnly(['uid', 'episodeKey', 'displayName', 'avatar', 'text', 'isSpoiler', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.episodeKey is string && data.episodeKey == episodeKey
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.avatar is string && data.avatar.size() <= 40000
        && data.text is string && data.text.size() >= 2 && data.text.size() <= 500
        && (!('isSpoiler' in data) || data.isSpoiler is bool)
        && data.createdAt is timestamp;
    }

    function isValidAnimeWatchedEntry(data, seasonId) {
      return data.keys().hasAll(['uid', 'seasonId', 'watchedEpisodes', 'updatedAtMs', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'seasonId', 'watchedEpisodes', 'updatedAtMs', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.seasonId is string && data.seasonId == seasonId
        && data.watchedEpisodes is list && data.watchedEpisodes.size() <= 5000
        && data.updatedAtMs is int && data.updatedAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Community Episode Comments
    match /episodes/{episodeKey}/comments/{commentId} {
      allow get: if isValidId(episodeKey) && isValidId(commentId) && isSignedIn();
      allow list: if isValidId(episodeKey) && isSignedIn();
      allow create: if isValidId(episodeKey) && isValidId(commentId)
        && isSignedIn()
        && isValidEpisodeComment(incoming(), episodeKey)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(episodeKey) && isValidId(commentId)
        && isSignedIn()
        && existing().uid == request.auth.uid;
    }

    // Real-Time Watch Together Rooms
    match /watch_rooms/{roomId} {
      allow get: if isValidId(roomId);
      allow list: if request.query.limit <= 20;
      allow create: if isValidId(roomId)
        && isValidWatchRoom(incoming(), roomId)
        && isValidWatchActor(incoming().hostUid)
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(roomId)
        && existing().status == 'active'
        && isValidWatchRoom(incoming(), roomId)
        && incoming().roomId == existing().roomId
        && incoming().hostUid == existing().hostUid
        && incoming().hostName == existing().hostName
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['animeId', 'seasonId', 'animeTitle', 'seasonNum', 'episodeNum', 'playbackState', 'playbackTime', 'updatedAtMs', 'updatedByUid', 'updatedByName', 'status', 'updatedAt']);
      allow delete: if isValidId(roomId)
        && isValidWatchActor(existing().hostUid);

      match /participants/{participantId} {
        allow get: if isValidId(roomId) && isValidId(participantId);
        allow list: if isValidId(roomId);
        allow create: if isValidId(roomId) && isValidId(participantId)
          && isValidWatchRoomParticipant(incoming(), roomId, participantId)
          && exists(/databases/$(database)/documents/watch_rooms/$(roomId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(roomId) && isValidId(participantId)
          && isValidWatchRoomParticipant(incoming(), roomId, participantId)
          && incoming().uid == existing().uid
          && incoming().roomId == existing().roomId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatar', 'lastSeenMs', 'createdAt', 'updatedAt']);
        allow delete: if isValidId(roomId) && isValidId(participantId)
          && isValidWatchActor(existing().uid);
      }

      match /messages/{messageId} {
        allow get: if isValidId(roomId) && isValidId(messageId);
        allow list: if isValidId(roomId);
        allow create: if isValidId(roomId) && isValidId(messageId)
          && isValidWatchRoomMessage(incoming(), roomId)
          && exists(/databases/$(database)/documents/watch_rooms/$(roomId))
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(roomId) && isValidId(messageId)
          && isValidWatchActor(existing().uid);
      }
    }

    // User Root Profile (Strictly private to the owner)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'avatar', 'profileUpdatedAt', 'email', 'providerId', 'episodesWatched', 'totalMinutes', 'totalSecondsWatched', 'updatedAt'])
        );
      allow delete: if isValidId(userId) && isOwner(userId);

      // Anime Favorites Subcollection
      match /favorites/{favoriteId} {
        allow get: if isValidId(userId) && isValidId(favoriteId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(favoriteId)
          && isOwner(userId)
          && isValidFavoriteAnime(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(favoriteId)
          && isOwner(userId)
          && isValidFavoriteAnime(incoming())
          && incoming().uid == existing().uid
          && incoming().animeId == existing().animeId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'coverImage', 'format', 'status', 'episodes', 'genres', 'idMal', 'averageScore', 'listStatus', 'listUpdatedAt', 'userScore', 'userReview', 'userNotes', 'scoreUpdatedAt', 'customListIds', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(favoriteId) && isOwner(userId);
      }

      // Deduplicated Anime Watched Episodes Subcollection
      match /anime_watched/{seasonId} {
        allow get: if isValidId(userId) && isValidId(seasonId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(seasonId)
          && isOwner(userId)
          && isValidAnimeWatchedEntry(incoming(), seasonId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(seasonId)
          && isOwner(userId)
          && isValidAnimeWatchedEntry(incoming(), seasonId)
          && incoming().uid == existing().uid
          && incoming().seasonId == existing().seasonId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['watchedEpisodes', 'updatedAtMs', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(seasonId) && isOwner(userId);
      }

      // Manga Favorites Subcollection
      match /manga_favorites/{mangaId} {
        allow get: if isValidId(userId) && isValidId(mangaId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(mangaId)
          && isOwner(userId)
          && isValidFavoriteManga(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(mangaId)
          && isOwner(userId)
          && isValidFavoriteManga(incoming())
          && incoming().uid == existing().uid
          && incoming().mangaId == existing().mangaId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'cover', 'flag', 'origLang', 'score', 'status', 'year', 'userScore', 'userReview', 'userNotes', 'scoreUpdatedAt', 'customListIds', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(mangaId) && isOwner(userId);
      }

      // Anime Watch History Subcollection
      match /history/{historyId} {
        allow get: if isValidId(userId) && isValidId(historyId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(historyId)
          && isOwner(userId)
          && isValidWatchHistoryEntry(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(historyId)
          && isOwner(userId)
          && isValidWatchHistoryEntry(incoming())
          && incoming().uid == existing().uid
          && incoming().animeId == existing().animeId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['animeTitle', 'coverImage', 'seasonNum', 'episodeNum', 'currentTime', 'duration', 'completed', 'timestamp', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(historyId) && isOwner(userId);
      }

      // Manga Reading Progress Subcollection
      match /manga_progress/{mangaId} {
        allow get: if isValidId(userId) && isValidId(mangaId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(mangaId)
          && isOwner(userId)
          && isValidMangaProgressEntry(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(mangaId)
          && isOwner(userId)
          && isValidMangaProgressEntry(incoming())
          && incoming().uid == existing().uid
          && incoming().mangaId == existing().mangaId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['mangaTitle', 'cover', 'flag', 'origLang', 'lastChapterNum', 'lastChapterLabel', 'readChapters', 'timestamp', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(mangaId) && isOwner(userId);
      }

      // User Settings & Reminders Subcollection
      match /settings/{settingId} {
        allow get: if isValidId(userId) && isValidId(settingId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(settingId)
          && isOwner(userId)
          && isValidUserSettings(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(settingId)
          && isOwner(userId)
          && isValidUserSettings(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['scheduleReminders', 'readerBg', 'readerWidth', 'readerMode', 'readerBrightness', 'readerContrast', 'readerSepia', 'readerContinuous', 'autoSkipIntro', 'autoSkipOutro', 'autoScrobble', 'pushEnabled', 'weeklySummaryPush', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(settingId) && isOwner(userId);
      }

      // User Custom Lists Subcollection
      match /custom_lists/{listId} {
        allow get: if isValidId(userId) && isValidId(listId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(listId)
          && isOwner(userId)
          && isValidCustomList(incoming(), listId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(listId)
          && isOwner(userId)
          && isValidCustomList(incoming(), listId)
          && incoming().uid == existing().uid
          && incoming().listId == existing().listId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'color', 'icon', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(listId) && isOwner(userId);
      }

      // User Push Subscriptions Subcollection
      match /push_subscriptions/{subId} {
        allow get: if isValidId(userId) && isValidId(subId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(subId)
          && isOwner(userId)
          && isValidPushSubscriptionEntry(incoming(), subId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(subId)
          && isOwner(userId)
          && isValidPushSubscriptionEntry(incoming(), subId)
          && incoming().uid == existing().uid
          && incoming().subId == existing().subId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['endpoint', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(subId) && isOwner(userId);
      }

      // User Suggestions Subcollection
      match /suggestions/{suggestionId} {
        allow get: if isValidId(userId) && isValidId(suggestionId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(suggestionId)
          && isOwner(userId)
          && isValidUserSuggestion(incoming())
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(suggestionId) && isOwner(userId);
      }
    }
  }
}
